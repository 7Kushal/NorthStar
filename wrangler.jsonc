{
  "name": "northstar",
  "compatibility_date": "2026-08-22",
  "main": "./worker/index.js",
  "access": {
    "dev": {
      "aud": "northstar-local",
      "identity": { "email": "local@northstar.dev" }
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
