{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "northstar",
  "compatibility_date": "2026-08-22",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgetrader-prod",
      "database_id": "d1ee16b3-c11d-4027-93ec-523a46ff619d",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://jangidkushal1998.cloudflareaccess.com",
    "POLICY_AUD": "e592244e6064e8d6d3bde0db1310adb30f96695aa803f09214528bd39250feea"
  },
  "access": {
    "dev": {
      "aud": "edgetrader-local",
      "identity": {
        "user_uuid": "local-edgetrader-user",
        "email": "local@edgetrader.dev",
        "name": "Local Trader"
      }
    }
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
